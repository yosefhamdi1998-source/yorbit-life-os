<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Yorbit's own privacy manifest.

	  This declares what THIS app collects and which required-reason APIs it
	  calls. Third-party SDKs ship their own manifests inside their bundles;
	  Apple merges them into the privacy report generated from the archive.
	  The SDKs in this app are Capacitor 8, @revenuecat/purchases-capacitor
	  and @sentry/react (JS-only, but Sentry's native layer may be linked).

	  VERIFY AGAINST THE ARCHIVE, NOT THIS FILE. Xcode's Product > Archive >
	  Generate Privacy Report reads the built .app and every embedded
	  framework. A manifest that is correct in source can still be incomplete
	  once a dependency is linked in, and Apple validates the archive.
	-->

	<!--
	  No tracking. Yorbit does not link user or device data to third-party
	  data for advertising, and contains no ad SDK or attribution network.
	  This must stay false, and NSPrivacyTrackingDomains stay empty, unless
	  an ad or attribution SDK is ever added - at which point App Tracking
	  Transparency also becomes required.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Email address: the account identifier for sign-in. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  Financial info: transactions, balances, budgets, bills. This is the
		  core of the product and is linked to the account by definition. It
		  is NOT used for tracking, advertising or analytics.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherFinancialInfo</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Purchase history: subscription state, via RevenueCat/Apple. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Account user ID, used to scope every row to its owner. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Crash and diagnostic data, via Sentry. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
		  UserDefaults. Capacitor stores its own bridge configuration and
		  plugin state there, and the RevenueCat SDK caches entitlement
		  state. CA92.1 is the reason code for an app reading and writing
		  only its own defaults, which is the case here - no app group, no
		  shared container.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
