{
  "name": "SavingsGoal",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "target_amount": {
      "type": "number"
    },
    "current_amount": {
      "type": "number",
      "default": 0
    },
    "icon": {
      "type": "string",
      "default": "\ud83c\udfaf"
    },
    "color": {
      "type": "string",
      "default": "#059669"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "target_amount"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}