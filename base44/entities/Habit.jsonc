{
  "name": "Habit",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly"
      ],
      "default": "daily"
    },
    "icon": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "target_days_per_week": {
      "type": "number",
      "default": 7
    },
    "completions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "streak": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}